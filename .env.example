# Copia este archivo como .env.local y ajusta los valores.

# Institución cuya identidad se aplica (colores, nombre, eslogan). Ver src/brand/index.ts.
VITE_BRAND=ambato

# Backend: "local" (demostración, datos en el navegador) o "supabase".
VITE_BACKEND=local

# Solo con VITE_BACKEND=supabase. Están en Supabase > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
